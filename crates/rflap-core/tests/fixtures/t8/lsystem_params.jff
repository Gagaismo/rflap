<?xml version="1.0" encoding="UTF-8" standalone="no"?><!--Created with JFLAP 6.4.--><structure>
	<type>lsystem</type>
	<!--The L-system axiom.-->
	<axiom>g(a*2) +(a) g(a) g</axiom>
	<!--The drawing parameters.-->
	<parameter>
		<name>a</name>
		<value>7</value>
	</parameter>
	<parameter>
		<name>b</name>
		<value>a+1</value>
	</parameter>
	<parameter>
		<name>c</name>
		<value>angle/2</value>
	</parameter>
	<parameter>
		<name>distance</name>
		<value>b</value>
	</parameter>
	<parameter>
		<name>angle</name>
		<value>b*10</value>
	</parameter>
</structure>